<div class="max-w-3xl mx-auto py-8">
  <div class="bg-white shadow rounded-lg overflow-hidden">
    <div class="px-6 py-4 border-b border-gray-200 text-xl font-semibold text-babu-700">Messages</div>
    <div class="p-6">
      <% if @conversations.any? %>
        <div class="space-y-4">
          <% @conversations.each do |conversation| %>
            <% other = current_user == conversation.sender ? conversation.recipient : conversation.sender %>
            <%= link_to conversation_messages_path(conversation), class: "block hover:bg-babu-50 transition rounded-lg p-4 border border-gray-100" do %>
              <div class="flex items-center gap-4">
                <% if conversation.messages.any? %>
                  <% if other %>
                    <% begin %>
                      <%= image_tag (other.image), class: "rounded-full h-12 w-12 object-cover border border-gray-200" %>
                    <% rescue StandardError %>
                      <%= image_tag "blank.jpg", class: "rounded-full h-12 w-12 object-cover border border-gray-200" %>
                    <% end %>
                  <% end %>
                  <div class="flex-1">
                    <div class="text-gray-800 font-medium truncate"><%= conversation.messages.last.context %></div>
                    <div class="text-xs text-gray-400 mt-1 flex items-center gap-2">
                      <% if other %>
                        <span class="font-semibold"><%= other.fullname %></span>
                      <% end %>
                      <span><%= conversation.messages.last.message_time %></span>
                    </div>
                  </div>
                  <div>
                    <%= link_to conversation_path(conversation), remote: true, method: :delete, data: {confirm: "Are you sure?"}, class: "text-gray-400 hover:text-red-500 transition" do %>
                      <i class="fas fa-trash-alt fa-lg" aria-hidden="true"></i>
                    <% end %>
                  </div>
                <% else %>
                  <div class="text-center w-full text-gray-400">No messages in this conversation.</div>
                <% end %>
              </div>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <div class="text-center text-gray-400 text-lg">You don't have any messages.</div>
      <% end %>
    </div>
  </div>
</div>
