<div class="flex items-start gap-4 py-4 border-b border-gray-100 group hover:bg-babu-50 transition">
  <% begin %>
    <%= image_tag (message.user.image), class: "rounded-full h-10 w-10 object-cover border border-gray-200" %>
  <% rescue StandardError %>
    <%= image_tag "blank.jpg", class: "rounded-full h-10 w-10 object-cover border border-gray-200" %>
  <% end %>
  <div class="flex-1">
    <div class="flex items-center gap-2">
      <span class="font-semibold text-babu-700"><%= message.user.fullname %></span>
      <span class="text-xs text-gray-400"><%= message.message_time %></span>
      <span class="ml-auto opacity-0 group-hover:opacity-100 transition">
        <%= link_to conversation_message_path(message.conversation_id, message), remote: true, method: :delete, data: {confirm: "Are you sure?"}, class: "text-gray-400 hover:text-red-500" do %>
          <i class="fas fa-trash-alt fa-md" aria-hidden="true"></i>
        <% end %>
      </span>
    </div>
    <div class="mt-1 text-gray-800"><%= message.context %></div>
  </div>
</div>