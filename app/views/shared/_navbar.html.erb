<!-- Static navbar -->
<nav class="bg-white shadow-md sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-wrap items-center justify-between py-2">
    <div class="flex items-center">
      <%= link_to image_tag("bounciehouse-logo.svg", alt: "BouncieHouse Logo", class: "h-10 w-auto"), root_path, class: "flex items-center" %>
    </div>
    <!-- Collect the nav links, forms, and other content for toggling -->
    <div class="flex-1 flex items-center justify-between">
      <%= form_tag search_path, class: "hidden md:block w-1/2 mx-4", method: :get do %>
        <%= text_field_tag :search, params[:search], placeholder: "Bounce Houses Near You", class: "w-full rounded border-gray-300 focus:ring focus:ring-babu-200 focus:border-babu-400 px-4 py-2 text-sm", id:"autoaddress" %>
      <% end %>
      <ul class="flex items-center gap-4 ml-auto">
        <% if !user_signed_in? %>
          <li><%= link_to "List a Bounce House", new_user_registration_path, class: "bg-babu-500 hover:bg-babu-600 text-white font-semibold px-4 py-2 rounded transition" %></li>
          <li><%= link_to "Login", new_user_session_path, class: "text-babu-600 hover:underline" %></li>
          <li><%= link_to "Sign Up", new_user_registration_path, class: "text-babu-600 hover:underline" %></li>
        <% else %>
          <li><%= link_to "List a Bounce House for Free", new_bouncehouse_path, class: "bg-babu-500 hover:bg-babu-600 text-white font-semibold px-4 py-2 rounded transition" %></li>
          <li>
            <%= link_to notifications_path, class: "relative" do %>
              <i class="fa fa-envelope fa-2x text-babu-500"></i>
              <% if current_user.unread > 0 %>
                <span class="absolute -top-2 -right-2 bg-red-500 text-white rounded-full text-xs px-2"><%= current_user.unread %></span>
              <% end %>
            <% end %>
          </li>
          <li class="relative group">
            <a href="#" class="flex items-center gap-2 focus:outline-none">
              <% if current_user.image_file_name.present? %>
                <% begin %>
                  <%= image_tag current_user.image.url(:thumb), class: "rounded-full h-8 w-8 object-cover border border-gray-300" %>
                <% rescue StandardError %>
                  <%= image_tag "blank.jpg", class: "rounded-full h-8 w-8 object-cover border border-gray-300" %>
                <% end %>
              <% else %>
                <%= image_tag "blank.jpg", class: "rounded-full h-8 w-8 object-cover border border-gray-300" %>
              <% end %>
              <span class="font-semibold"><%= current_user.fullname %></span>
              <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </a>
            <ul class="absolute right-0 mt-2 w-48 bg-white border border-gray-200 rounded shadow-lg opacity-0 group-hover:opacity-100 transition pointer-events-none group-hover:pointer-events-auto z-50">
              <li><%= link_to "Dashboard", dashboard_path, class: "block px-4 py-2 hover:bg-gray-100" %></li>
              <li><%= link_to "Manage Listing", bouncehouses_path, class: "block px-4 py-2 hover:bg-gray-100" %></li>
              <li><%= link_to "List a Bounce House", new_bouncehouse_path, class: "block px-4 py-2 hover:bg-gray-100" %></li>
              <li><%= link_to "Previous Reservations", previous_reservations_path, class: "block px-4 py-2 hover:bg-gray-100" %></li>
              <li><%= link_to "Current Reservations", current_reservations_path, class: "block px-4 py-2 hover:bg-gray-100" %></li>
              <li><hr class="my-1 border-t border-gray-200"></li>
              <li><%= link_to "Edit Profile", edit_user_registration_path, class: "block px-4 py-2 hover:bg-gray-100" %></li>
              <li><%= link_to "Log Out", destroy_user_session_path, method: :delete, class: "block px-4 py-2 hover:bg-gray-100 text-red-600" %></li>
            </ul>
          </li>
        <% end %>
      </ul>
    </div>
  </div>
</nav>

<% if user_signed_in? && !current_page?(root_path) %>
  <nav class="navbar navbar-default static-top" style="background-color: #FBFCFC;">
    <div class="container">
      <ul class="nav navbar-nav">
        <li class="<%= 'active' if current_page?(current_user) %>"><%= link_to "Profile", current_user %></li>
        <li class="<%= 'active' if current_page?(dashboard_path) %>"><%= link_to "Dashboard", dashboard_path %></li>
        <li class="<%= 'active' if current_page?(bouncehouses_path) %>"><%= link_to "Manage Listings", bouncehouses_path %></li>
        <li class="<%= 'active' if current_page?(conversations_path) %>"><%= link_to "Messages", conversations_path %></li>

        <% if current_user.bouncehouses.any? %>
          <li class="<%= 'active' if current_page?(revenues_path) %>"><%= link_to "Revenues", revenues_path %></li>
        <% end %>
        <li class="<%= 'active' if current_page?(current_reservations_path) %>"><%= link_to "Current Reservations", current_reservations_path %></li>

        <% if current_user.bouncehouses.any? %>
          <li class="<%= 'active' if current_page?(host_calendar_path) %>"><%= link_to "Host Calendar", host_calendar_path %></li>
        <% end %>

        <li class="<%= 'active' if current_page?(payment_method_path) %>"><%= link_to "Account Settings", payment_method_path %></li>
      </ul>
    </div>
  </nav>
<% end %>
