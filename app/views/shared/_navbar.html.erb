<!-- Static navbar -->
<nav class="navbar navbar-default navbar-static-top" style="margin-bottom: 0; background-color: #FBFCFC;">
  <div class="container">
    <div class="navbar-header">
      <button type="button" class="navbar-toggle collapsed" data-toggle="collapse" data-target="#navbar" aria-expanded="false" aria-controls="navbar">
        <span class="sr-only">Toggle navigation</span>
        <span class="icon-bar"></span>
        <span class="icon-bar"></span>
        <span class="icon-bar"></span>
      </button>
      <%= link_to image_tag("bounciehouse-logo.svg", alt: "BouncieHouse Logo", style: "height: 40px;"), root_path, class: "navbar-brand" %>
    </div>
    <div id="navbar" class="navbar-collapse collapse">
      <ul class="nav navbar-nav navbar-right">
        <% if !user_signed_in? %>
          <li><%= link_to "List a Bounce House", new_user_registration_path %></li>
          <li><%= link_to "Login", new_user_session_path %></li>
          <li><%= link_to "Sign Up", new_user_registration_path %></li>
        <% else %>
          <li><%= link_to "List a Bounce House for Free", new_bouncehouse_path %></li>
          <li><%= link_to "Dashboard", dashboard_path %></li>
          <li><%= link_to "Manage Listings", bouncehouses_path %></li>
          <li><%= link_to "Messages", conversations_path %></li>
          <li><%= link_to "Current Reservations", current_reservations_path %></li>
          <li class="dropdown">
            <a href="#" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false">
              <% if current_user.image_file_name.present? %>
                <% begin %>
                  <%= image_tag current_user.image.url(:thumb), class: "img-circle avatar-small" %>
                <% rescue StandardError %>
                  <%= image_tag "blank.jpg", class: "img-circle avatar-small" %>
                <% end %>
              <% else %>
                <%= image_tag "blank.jpg", class: "img-circle avatar-small" %>
              <% end %>
              <%= current_user.fullname %> <span class="caret"></span>
            </a>
            <ul class="dropdown-menu">
              <li><%= link_to "Profile", current_user %></li>
              <li><%= link_to "Edit Profile", edit_user_registration_path %></li>
              <li role="separator" class="divider"></li>
              <li><%= link_to "Log Out", destroy_user_session_path, method: :delete %></li>
            </ul>
          </li>
        <% end %>
      </ul>
    </div><!--/.nav-collapse -->
  </div>
</nav>
