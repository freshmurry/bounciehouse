<% photos = Photo.where.not(bouncehouse_id: nil) %>
<% if photos.present? %>
  <div class="">
    <% photos.each do |photo| %>
      <% if photo.images.attached? %>
        <div class="col-12 col-sm-6 col-md-4 mb-4">
          <div class="card shadow-sm position-relative">
            <%= image_tag url_for(photo.images.first), class: "card-img-top", style: "height: 220px; object-fit: cover;" %>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
<% else %>
  <p>No photos available.</p>
<% end %>
