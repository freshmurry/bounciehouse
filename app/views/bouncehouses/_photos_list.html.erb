<!-- bouncehouses/photos/_photos_list.html.erb -->
<% if @photos %>
  <div class="row">
    <% @bouncehouse.photos.each do |photo| %>
      <div class="col-md-4">
        <div class="panel panel-default">
          <div class="panel-heading preview">
            <% begin %>
              <% img_url = photo.image.url(:medium, false) %>
              <% img_url = img_url.start_with?('http') ? img_url : "#{request.base_url}#{img_url}" %>
              <%= image_tag img_url %>
            <% rescue StandardError %>
              <%= image_tag 'blank.jpg' %>
            <% end %>
          </div>

          <div class="panel-body">
            <div class="container"> 
              <span class="pull-right">
                <%= link_to bouncehouse_photo_path(photo.bouncehouse, photo), remote: true, method: :delete, data: {confirm: "Are you sure?"} do %>
                  <i class="fa fa-trash fa-lg"></i>
                <% end %>
              </span>
            </div> 
          </div>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <p>No photos available.</p>
<% end %>
